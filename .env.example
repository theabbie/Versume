# Jina Reader API key (optional).
# Copy this file to `.env.local` (dev) or set it as a Vercel project env var (prod).
# Must use the NEXT_PUBLIC_ prefix so it is inlined into the client bundle at build time.
#
# Without a key the job-link fetch degrades gracefully using Jina's anonymous quota.
NEXT_PUBLIC_JINA_API_KEY=
